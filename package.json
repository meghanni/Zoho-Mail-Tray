{
  "name": "zoho-mail-tray",
  "productName": "Zoho Mail Tray",
  "version": "0.2.3",
  "description": "A Linux tray app for Zoho Mail with separate account windows",
  "author": "Zoho Mail Tray contributors",
  "homepage": "https://mail.zoho.com",
  "main": "electron/main.js",
  "desktopName": "com.example.zohomailtray",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --dir && bash packaging/electron/build-deb.sh"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.example.zohomailtray",
    "productName": "Zoho Mail Tray",
    "directories": {
      "output": "outputs/electron"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "icons/zoho-tray.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office;Email",
      "syncDesktopName": true,
      "maintainer": "Zoho Mail Tray contributors <noreply@example.invalid>",
      "icon": "icons/zoho-tray.png",
      "artifactName": "zoho-mail-tray_${version}_${arch}.deb"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libasound2",
        "libatspi2.0-0",
        "libgbm1",
        "libnotify4",
        "libnss3",
        "libuuid1",
        "libsecret-1-0",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ]
    }
  }
}
